/*
 * -------------------------------------------------------------------
 *  Motif-Miner: BGC Regulatory Motif Discovery Pipeline
 *  Nextflow configuration
 *
 *  The per-process resource allocations below were tuned for one
 *  SLURM cluster (-profile hpc). Adjust them for your own system; they
 *  do not affect the analysis itself.
 * -------------------------------------------------------------------
 */

manifest {
    name            = 'sysbiomelab/Motif-Miner'
    author          = 'Idris Matine'
    homePage        = 'https://github.com/sysbiomelab/Motif-Miner'
    description     = 'Discovery of conserved regulatory motifs in the upstream regions of BGC families'
    mainScript      = 'main.nf'
    nextflowVersion = '>=21.10.0'
    version         = '1.0.0'
}

params {
    input_dir        = false 
    outdir           = './results'
    tempdir          = './temp'
    min_upstream_len = 100
    max_upstream_len = 350
    inside_gene_len  = 20
    org_threshold    = 1.0
    help             = false
    max_time         = '46h'
}

executor {
    queueStatInterval = '1m'
    queueStatTimeout  = '10m'
    submitRateLimit   = '20 sec'
    queueSize         = 13
}

process {
    conda  = "${projectDir}/conf/conda.yml"
    
    // Default resources for lightweight processes
    cpus   = 1
    memory = '8.GB'
    time   = '6.h'
    // scratch = true

    errorStrategy = {
        def exitStatus = task.exitStatus
        def err = task.errorMessage ?: ''
        if( exitStatus in [140,143] || err.contains('Socket timed out') ) 
            return 'retry'
        return 'terminate'
    }

    maxRetries = 3
    retryDelay = '5 min'

    // ===================================================
    // Process-specific resource allocations
    // ===================================================

    withName: 'PREPARE_INPUTS' {
        cpus   = 1
        memory = '16.GB'
        time   = '2.h'
    }

    withName: 'PROTEINORTHO' {
        scratch = true
        cpus   = 50
        memory = { 300.GB * task.attempt }
        time   = '48.h'

    }

    withName: 'EXTRACT_COGS' {
        cpus   = 1
        memory = '16.GB'
        time   = '8.h'
    }

    withName: 'EXTRACT_AND_FILTER_UPSTREAM' {
        cpus   = 1
        memory = '16.GB'
        time   = '8.h'
    }

    withName: 'CDHIT' {
        cpus   = 50
        memory = '200.GB'
        time   = '24.h'
    }

    withName: 'GET_CDHIT_STATS' {
        cpus   = 1
        memory = '8.GB'
        time   = '8.h'
    }

    withName: 'GET_GENE_INFO' {
        cpus   = 1
        memory = '8.GB'
        time   = '8.h'
    }

    withName: 'MEME' {
        cpus   = 50
        memory = '200.GB'
        time   = '48.h'
    }

    withName: 'PARSE_MEME' {
        cpus   = 1
        memory = '16.GB'
        time   = '8.h'
    }

    withName: 'ORGANIZE_RESULTS' {
        cpus   = 1
        memory = '16.GB'
        time   = '8.h'
    }

    withName: 'FINAL_SUMMARY' {
        cpus   = 1
        memory = '8.GB'
        time   = '8.h'
    }
}

profiles {
    standard {
        process.executor = 'local'
    }

    hpc {
        process {
            executor = 'slurm'
            queue = 'cpu'
            maxRetries = 6
            queueStatActive = true
        }
    }

    // Run the containerised tools with Docker instead of Singularity,
    // e.g. `-profile standard,docker` on a workstation.
    docker {
        docker.enabled      = true
        singularity.enabled = false
    }
}

/*
 * Software provisioning
 *   - Python steps run in the Conda environment defined in conf/conda.yml
 *   - ProteinOrtho, CD-HIT and MEME run in version-pinned containers
 *     (Singularity/Apptainer by default; see the `docker` profile)
 *
 * Cache locations are deliberately not hardcoded. On a shared cluster,
 * point them at a shared filesystem with the standard Nextflow variables
 * before launching:
 *   export NXF_CONDA_CACHEDIR=/shared/path/conda_cache
 *   export NXF_SINGULARITY_CACHEDIR=/shared/path/singularity_cache
 */
conda {
    enabled = true
}

singularity {
    enabled    = true
    autoMounts = true
    runOptions = '--bind /etc/passwd:/etc/passwd'
}

docker.enabled = false
